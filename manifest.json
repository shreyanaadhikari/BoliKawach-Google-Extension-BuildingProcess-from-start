{
    "manifest_version": 3,
    "name": "BoliKawach",
    "version": "0.1.0",
    "description": "BoliKawach detects and flags Nepali Hate speech or comments written under various social media platforms in real time.",
    "permissions": ["storage", "tabs"],
    "host_permissions": [
        "https://bolikawach.onrender.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.youtube.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
  },
  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["facebook.js"],
      "run_at": "document_idle"
    },
    {
        "matches": ["https://*.instagram.com/*"],
        "js": ["instagram.js"],
        "run_at": "document_idle"
      },
      {
        "matches": ["https://*.youtube.com/*"],
        "js": ["youtube.js"],
        "run_at": "document_idle"
      }
],
"icons": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
}
}